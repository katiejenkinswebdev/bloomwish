# Copy this file to .env and fill in real values.
# EXPO_PUBLIC_* vars are bundled into the client — never put secrets here.
# Secrets (Anthropic, ElevenLabs, Supabase service role) live ONLY in
# Supabase Edge Function secrets (`supabase secrets set ...`), never in the app.

# --- Supabase (public, safe for client) ---
# TODO: create a Supabase project at https://supabase.com/dashboard and fill these in.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- RevenueCat (public SDK keys, safe for client) ---
# TODO: create a RevenueCat project at https://app.revenuecat.com and fill these in.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Sign-In (public client IDs, safe for client) ---
# TODO: create OAuth client IDs at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# The following are SECRET and must be set via `supabase secrets set` for use
# inside Edge Functions ONLY. They are listed here for reference — do not
# add them to the Expo app's env.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxxx
#   supabase secrets set ELEVENLABS_API_KEY=xxxxx
#   supabase secrets set ELEVENLABS_VOICE_ID=xxxxx
# ---------------------------------------------------------------------------

# PostHog product analytics (public key; safe for client). Leave placeholder to disable.
EXPO_PUBLIC_POSTHOG_KEY=phc_placeholder
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting (public DSN). Leave placeholder to disable.
EXPO_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
