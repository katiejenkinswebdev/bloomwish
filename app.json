{
  "expo": {
    "name": "Bloomwish",
    "slug": "bloomwish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bloomwish",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF3E7",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.bloomwish.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bloomwish uses your microphone so you can dictate your dream instead of typing. Audio is transcribed on-device and never uploaded or stored.",
        "NSSpeechRecognitionUsageDescription": "Bloomwish uses on-device speech recognition to turn your spoken words into text for your dream. Only the transcript is kept."
      }
    },
    "android": {
      "package": "com.bloomwish.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
